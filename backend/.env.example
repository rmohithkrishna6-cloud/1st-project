# PostgreSQL database connection string
DATABASE_URL="postgresql://nexora:nexorapassword@localhost:5432/nexoradb?schema=public"

# Backend server port
PORT=5000

# Secret key for JWT token signing (minimum 32 characters, preferably 64-character hex)
JWT_SECRET="replace_with_a_secure_random_64_character_secret_key"

# CORS allowed origins (comma-separated list of URLs)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
